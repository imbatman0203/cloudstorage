# Afterframe configuration
# Copy to .env and adjust for your environment.
# Leave SUPABASE_* blank to run with local filesystem storage in ./data.

PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
AFTERFRAME_SIGNING_SECRET=change-me-to-a-long-random-secret

# Optional: enable Supabase Auth, Postgres metadata, and private Storage bucket
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
